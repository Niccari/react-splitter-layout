{
  "name": "react-splitter-layout",
  "version": "4.0.2",
  "description": "A simple split layout for React and modern browsers",
  "keywords": [
    "react",
    "layout",
    "split",
    "splitter"
  ],
  "author": "Yang Liu <hi@zesik.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zesik/react-splitter-layout"
  },
  "bugs": {
    "url": "https://github.com/zesik/react-splitter-layout/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/*"
  ],
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "coveralls-next": "^6.0.1",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.4.0",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^27.4.0",
    "raf": "^3.4.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0",
    "style-loader": "^4.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "peerDependencies": {
    "react": ">=15.5.0 <20"
  },
  "peerDependenciesMeta": {
    "prop-types": {
      "optional": true
    }
  },
  "scripts": {
    "prepublish": "webpack --progress && tsc --emitDeclarationOnly",
    "clean": "rm -rf ./lib",
    "build": "webpack --progress && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test example index.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "coveralls": "vitest run --coverage && cat ./coverage/lcov.info | coveralls",
    "example": "cd example && webpack-dev-server"
  }
}
